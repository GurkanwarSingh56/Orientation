rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user is accessing their own data
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
    
    // Users collection
    match /users/{userId} {
      // Anyone can read user profiles (for team pages, member lists)
      allow read: if true;
      
      // Users can only write to their own profile, admins can write to any
      allow write: if isOwner(userId) || isAdmin();
      
      // Users cannot change their own role
      allow update: if isOwner(userId) && 
                       (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']));
    }
    
    // Events collection
    match /events/{eventId} {
      // Anyone can read events (public event listings)
      allow read: if true;
      
      // Only admins can create, update, or delete events
      allow create, update, delete: if isAdmin();
    }
    
    // Registrations collection
    match /registrations/{registrationId} {
      // Users can read their own registrations, admins can read all
      allow read: if isAuthenticated() && 
                     (resource.data.studentId == request.auth.uid || isAdmin());
      
      // Users can create their own registrations with validation
      allow create: if isAuthenticated() && 
                       request.resource.data.studentId == request.auth.uid &&
                       request.resource.data.keys().hasAll([
                         'eventId', 
                         'eventName', 
                         'studentName', 
                         'studentEmail', 
                         'studentId',
                         'department',
                         'year',
                         'timestamp'
                       ]);
      
      // Only admins can update or delete registrations
      allow update, delete: if isAdmin();
    }
    
    // Projects collection (optional, for future use)
    match /projects/{projectId} {
      // Anyone can read projects (public project showcase)
      allow read: if true;
      
      // Only admins can create, update, or delete projects
      allow create, update, delete: if isAdmin();
    }
    
    // Deny all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
