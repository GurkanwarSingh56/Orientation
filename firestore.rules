rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    // 1. Domains: Read-only for authenticated/public users; Admin write only
    match /domains/{domainId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 2. Questions: Read-only for users; Admin write only
    match /questions/{questionId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // 3. Quiz Attempts: Users can read/create their own attempts only; No updates/deletes allowed
    match /quizAttempts/{attemptId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.participantId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.participantId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // 4. Quiz Results: Users can read/create their own results only; No tampering with scores
    match /quizResults/{resultId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.participantId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.participantId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // 5. Participants: Users can read/write their own profile only; Cannot impersonate others
    match /participants/{participantId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(participantId);
      allow delete: if isAdmin();
    }

    // 6. Live Quiz Sessions
    // Clients only read session data. All creates/updates/submissions go through secure API routes using Admin SDK.
    match /quizSessions/{sessionId} {
      allow read: if true;
      allow write: if false; // Only Admin SDK (server) can write
      
      // Subcollections
      match /leaderboard/{participantId} {
        allow read: if true;
        allow write: if false; // Only Admin SDK
      }
      
      match /participants/{participantId} {
        // Participants can read their own detailed doc to restore state, or public can read it if needed.
        allow read: if true;
        allow write: if false; // Only Admin SDK processes answers
      }
    }
  }
}
